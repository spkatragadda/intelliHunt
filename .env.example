# Copy this file to .env and fill in the values before running docker compose.

# Django secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=

# Set to False in production
DEBUG=False

# Comma-separated list of domains/IPs Django will serve
# e.g. yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Must match your domain with scheme — used for CSRF validation
# e.g. https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Must match your domain — used for CORS on the Django API
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── LLM model tiers for repo scanning ────────────────────────────────────────
# "Speed" tier uses a fast, cheaper model; "Legend" uses a larger, more capable one.
# Falls back to MODEL if the tier-specific var is unset.
SPEED_MODEL=openai/gpt-4o-mini
LEGEND_MODEL=openai/gpt-4o
SPEED_MAX_TOKENS=16248
LEGEND_MAX_TOKENS=32000

# Admin account password (min 12 chars). If unset, auto-generated on first start.
ADMIN_PASSWORD=

# ── Email (Zoho Mail) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@intellihunt.io
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@intellihunt.io

# Public-facing frontend URL — used to build links inside outbound emails
# (account approval, password reset). No trailing slash.
FRONTEND_URL=https://intellihunt.io

# Set to true when running behind Nginx/Cloudflare so Django trusts
# X-Forwarded-Proto and avoids infinite SSL redirect loops.
BEHIND_PROXY=true

# ── Neo4j Knowledge Graph ────────────────────────────────────────────────────
NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
